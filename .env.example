# Copy to .env.local and fill in values from:
# https://dashboard.clerk.com → your application → API Keys
#
# After changing .env.local: stop `npm run dev` (Ctrl+C), then start again. Hot "Reload env"
# can time out and leave the app blank until you do a full restart.
#
# Stabilizes Server Action IDs across dev restarts / HMR (avoids "Failed to find Server Action"
# with Clerk and other libraries that register actions). Generate: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
#
# Publishable key (safe in the browser) — starts with pk_test_ or pk_live_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret key (server only — never commit) — starts with sk_test_ or sk_live_
CLERK_SECRET_KEY=

# Optional: match your app routes (defaults work if you use /sign-in and /sign-up)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
